# Backend Server Configuration
PORT=5000

# PostgreSQL Database Configuration
# Use DB_HOST=localhost for local dev, or DB_HOST=db when running in Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskflow_user
DB_PASSWORD=taskflow_secure_password
DB_NAME=taskflow_db

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d

